{
  "extends": ["../../tsconfig.base.json", "./.wxt/tsconfig.json"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "types": ["vitest/globals", "@testing-library/jest-dom"],
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] }
  },
  "include": [
    "components/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "entrypoints/**/*.ts",
    "entrypoints/**/*.tsx",
    "vitest.config.ts",
    "wxt.config.ts",
    ".wxt/wxt.d.ts"
  ]
}
