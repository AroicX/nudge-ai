    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@fastify/cors": "11.3.1",
    "@fastify/multipart": "10.1.4",
    "@fastify/rate-limit": "11.2.1",
    "@nudge/contracts": "workspace:*",
    "@nudge/core": "workspace:*",
    "dotenv": "18.0.8",
    "fastify": "5.12.7",
    "mammoth": "^1.13.0",
    "openai": "7.34.0",
    "pdfjs-dist": "^6.4.299",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "tsx": "4.23.15"
  }
