# Copy to .env. Generate a pairing secret with: openssl rand -hex 24
# Use the same value for both pairing variables, then rebuild the extension.
# Do not commit .env. Do not put an OpenAI key in the extension build.

OPENAI_API_KEY=
OPENAI_AGENT_MODEL=gpt-4.1-mini
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
NUDGE_PAIRING_SECRET=
NUDGE_SERVER_URL=http://127.0.0.1:4317
WXT_PUBLIC_NUDGE_PAIRING_SECRET=
WXT_PUBLIC_NUDGE_SERVER_URL=http://127.0.0.1:4317
